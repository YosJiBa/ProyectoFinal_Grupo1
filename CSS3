/*  ESTILO GLOBAL  */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f0f0f0;
}

.pantalla {
    padding: 30px;
    display: none; /* Tus compañeros activarán cada pantalla con PHP */
}

/* LOGIN  */
#login {
    display: block;
}

.login-container {
    width: 350px;
    margin: auto;
    margin-top: 80px;
    background: white;
    padding: 25px;
    border-radius: 8px;
    box-shadow: 0 0 10px #777;
}

.login-container h1 {
    text-align: center;
    margin-bottom: 20px;
}

.input-group {
    margin-bottom: 15px;
}

input {
    width: 100%;
    padding: 8px;
}

button {
    background: #005f99;
    border: none;
    color: white;
    padding: 10px;
    margin-top: 10px;
    cursor: pointer;
}

/*  DASHBOARD  */

header {
    display: flex;
    align-items: center;
    gap: 20px;
    background: #005f99;
    color: white;
    padding: 20px;
}

.container {
    display: flex;
}

.menu {
    width: 220px;
    background: #333;
    min-height: 100vh;
}

.menu ul {
    list-style: none;
}

.menu a {
    display: block;
    padding: 15px;
    color: white;
    text-decoration: none;
}

.menu a:hover {
    background: #444;
}

.contenido {
    padding: 20px;
    width: 100%;
}

/*  MANTENIMIENTOS  */

h1 {
    text-align: center;
    margin-bottom: 25px;
}

.form-mant {
    width: 550px;
    background: #fff;
    padding: 20px;
    margin: auto;
    display: flex;
    gap: 15px;
    flex-direction: column;
    border-radius: 6px;
    box-shadow: 0 0 5px #999;
}

textarea {
    height: 80px;
    resize: none;
}

.tabla-datos {
    width: 90%;
    margin: 25px auto;
    border-collapse: collapse;
}

.tabla-datos th,
.tabla-datos td {
    border: 1px solid #aaa;
    padding: 10px;
    text-align: left;
}

/*  CONSULTA AJAX */

.buscador {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 20px;
}

#resultado {
    width: 400px;
    margin: auto;
    background: #fff;
    padding: 20px;
    border-radius: 6px;
    box-shadow: 0 0 5px #999;
}
